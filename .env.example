# Copy to .env for local non-secret configuration. Never commit real secrets.
# Pass values with --dart-define or --dart-define-from-file=.env at build time;
# this file is not loaded automatically at runtime.
# Firebase is the default. Only explicit mock selects in-memory data sources;
# empty or unknown BACKEND_PROVIDER values also select Firebase.
BACKEND_PROVIDER=firebase

# Firebase client configuration is generated in lib/core/firebase/firebase_options.dart
# and platform files. Never place server keys or client secrets in the app.
# Optional OAuth web client ID (ID token audience); empty uses platform defaults.
GOOGLE_SERVER_CLIENT_ID=
# Optional OAuth iOS client ID; empty uses platform defaults.
GOOGLE_IOS_CLIENT_ID=
